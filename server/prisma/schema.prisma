datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol      @default(EDITOR_NOTICIAS)
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
  
  @@map("usuarios")
}

enum Rol {
  SUPERADMIN
  EDITOR_NOTICIAS
  EDITOR_HORARIOS
  EDITOR_SERVICIOS
}

model Noticia {
  id           Int      @id @default(autoincrement())
  titulo       String?
  slug         String   @unique
  extracto     String?  @db.VarChar(200)
  contenido    String?  @db.Text
  imagenUrl    String?
  embedUrl     String?  // iframe HTML de redes sociales (Facebook, Instagram, X)
  categoria    String
  publicado    Boolean  @default(false)
  publicadoEn  DateTime?
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  
  @@index([categoria])
  @@index([publicado])
  @@map("noticias")
}

model Especialidad {
  id           Int      @id @default(autoincrement())
  nombre       String   @unique
  icono        String   // Nombre del icono de Lucide
  descripcion  String?  @db.Text
  disponible   Boolean  @default(true)
  orden        Int      @default(0)
  medicos      Medico[]
  
  @@map("especialidades")
}

model Medico {
  id             Int          @id @default(autoincrement())
  nombre         String
  especialidadId Int
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id])
  foto           String?      // URL avatar (jpg/png)
  cvUrl          String?      // URL PDF hoja de vida
  bio            String?      @db.Text
  telefono       String?
  email          String?
  activo         Boolean      @default(true)
  horarios       HorarioMedico[]
  
  @@index([especialidadId])
  @@map("medicos")
}

model HorarioMedico {
  id        Int      @id @default(autoincrement())
  medicoId  Int
  medico    Medico   @relation(fields: [medicoId], references: [id])
  mes       String   // formato: "2026-04"
  lunes     String?
  martes    String?
  miercoles String?
  jueves    String?
  viernes   String?
  estado    EstadoHorario @default(DISPONIBLE)
  
  @@unique([medicoId, mes])
  @@index([mes])
  @@map("horarios_medicos")
}

enum EstadoHorario {
  DISPONIBLE
  VACACIONES
  SIN_ATENCION
}

// Tabla para la Matriz de Guardias real del hospital (formato Excel institucional)
model GuardiaMatriz {
  id              Int      @id @default(autoincrement())
  mes             String   // formato: "2026-05"
  tipoContrato    String?  // TC1, TC3, GUARDIA 1, etc.
  nombreMedico    String
  area            String?  // especialidad / área asignada
  telefono        String?
  // 31 columnas para cada día del mes (valor: "X", "VACACIONES", "G", "M", etc. o null)
  d01 String? @db.VarChar(100)
  d02 String? @db.VarChar(100)
  d03 String? @db.VarChar(100)
  d04 String? @db.VarChar(100)
  d05 String? @db.VarChar(100)
  d06 String? @db.VarChar(100)
  d07 String? @db.VarChar(100)
  d08 String? @db.VarChar(100)
  d09 String? @db.VarChar(100)
  d10 String? @db.VarChar(100)
  d11 String? @db.VarChar(100)
  d12 String? @db.VarChar(100)
  d13 String? @db.VarChar(100)
  d14 String? @db.VarChar(100)
  d15 String? @db.VarChar(100)
  d16 String? @db.VarChar(100)
  d17 String? @db.VarChar(100)
  d18 String? @db.VarChar(100)
  d19 String? @db.VarChar(100)
  d20 String? @db.VarChar(100)
  d21 String? @db.VarChar(100)
  d22 String? @db.VarChar(100)
  d23 String? @db.VarChar(100)
  d24 String? @db.VarChar(100)
  d25 String? @db.VarChar(100)
  d26 String? @db.VarChar(100)
  d27 String? @db.VarChar(100)
  d28 String? @db.VarChar(100)
  d29 String? @db.VarChar(100)
  d30 String? @db.VarChar(100)
  d31 String? @db.VarChar(100)
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  @@index([mes])
  @@index([nombreMedico])
  @@map("guardias_matriz")
}

model DocumentoAcademico {
  id          Int      @id @default(autoincrement())
  titulo      String
  tipo        String   // paper, guia, protocolo, manual, estudio
  driveUrl    String?  // Opcional, link original
  archivoUrl  String?  // Ruta local en server/public/uploads
  publicadoEn DateTime @default(now())
  chunks      DocumentoChunk[]
  
  @@index([tipo])
  @@map("documentos_academicos")
}

model DocumentoChunk {
  id            Int                @id @default(autoincrement())
  documentoId   Int
  documento     DocumentoAcademico @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  contenido     String             @db.Text
  pagina        Int?
  // Nota: Para pgvector usaremos una migración SQL manual ya que Prisma no soporta el tipo vector nativamente aún
  // Pero definiremos un campo para identificar el chunk
  orden         Int
  
  @@index([documentoId])
  @@map("documentos_chunks")
}

model Configuracion {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor String @db.Text
  
  @@map("configuracion")
}

model MensajeContacto {
  id         Int      @id @default(autoincrement())
  nombre     String
  email      String
  telefono   String?
  asunto     String
  mensaje    String   @db.Text
  leido      Boolean  @default(false)
  creadoEn   DateTime @default(now())
  
  @@index([leido])
  @@index([creadoEn])
  @@map("mensajes_contacto")
}
