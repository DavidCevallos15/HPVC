datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  nombre   String
  rol      Rol      @default(EDITOR_NOTICIAS)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  @@map("usuarios")
}

enum Rol {
  SUPERADMIN
  EDITOR_NOTICIAS
  EDITOR_HORARIOS
  EDITOR_SERVICIOS
}

model Noticia {
  id            Int       @id @default(autoincrement())
  titulo        String?
  slug          String    @unique
  extracto      String?   @db.VarChar(200)
  contenido     String?   @db.Text
  imagenUrl     String?
  embedUrl      String? // iframe HTML de redes sociales (Facebook, Instagram, X)
  categoria     String
  publicado     Boolean   @default(false)
  publicadoEn   DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@index([categoria])
  @@index([publicado])
  @@map("noticias")
}

model Especialidad {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  icono       String // Nombre del icono de Lucide
  descripcion String?  @db.Text
  disponible  Boolean  @default(true)
  orden       Int      @default(0)
  medicos     Medico[]

  @@map("especialidades")
}

model Medico {
  id             Int             @id @default(autoincrement())
  nombre         String
  especialidadId Int
  especialidad   Especialidad    @relation(fields: [especialidadId], references: [id])
  foto           String? // URL avatar (jpg/png)
  cvUrl          String? // URL PDF hoja de vida
  bio            String?         @db.Text
  telefono       String?
  email          String?
  activo         Boolean         @default(true)
  horarios       HorarioMedico[]

  @@index([especialidadId])
  @@map("medicos")
}

model HorarioMedico {
  id        Int           @id @default(autoincrement())
  medicoId  Int
  medico    Medico        @relation(fields: [medicoId], references: [id])
  mes       String // formato: "2026-04"
  lunes     String?
  martes    String?
  miercoles String?
  jueves    String?
  viernes   String?
  estado    EstadoHorario @default(DISPONIBLE)

  @@unique([medicoId, mes])
  @@index([mes])
  @@map("horarios_medicos")
}

enum EstadoHorario {
  DISPONIBLE
  VACACIONES
  SIN_ATENCION
}

model DocumentoAcademico {
  id          Int      @id @default(autoincrement())
  titulo      String
  tipo        String // paper, guia, protocolo, manual, estudio
  driveUrl    String
  publicadoEn DateTime @default(now())

  @@index([tipo])
  @@map("documentos_academicos")
}

model Configuracion {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor String @db.Text

  @@map("configuracion")
}

model MensajeContacto {
  id       Int      @id @default(autoincrement())
  nombre   String
  email    String
  telefono String?
  asunto   String
  mensaje  String   @db.Text
  leido    Boolean  @default(false)
  creadoEn DateTime @default(now())

  @@index([leido])
  @@index([creadoEn])
  @@map("mensajes_contacto")
}
