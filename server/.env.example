# Correo SMTP para autorespuestas del formulario Contáctenos
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hospital Provincial Verdi Cevallos Balda <no-reply@hpvc.gob.ec>"
SMTP_SECURE=false

# Ajustes opcionales de la cola
EMAIL_QUEUE_BATCH_SIZE=3
EMAIL_QUEUE_POLL_MS=5000
EMAIL_QUEUE_MAX_ATTEMPTS=3
EMAIL_QUEUE_LOCK_TIMEOUT_MS=300000
