			$space=$this->_escape($space); 
			$sub .=sprintf('BT '.$aix.' %.3F Tc [',$px,$py, $this->charspacing);
			$t = explode(' ',$txt2);
			$numt = count($t);
			for($i=0;$i<$numt;$i++) {
