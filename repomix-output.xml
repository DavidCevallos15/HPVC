const prisma = new PrismaClient();

async function fixConfig() {
  const correctData = [
    { clave: 'hospital_nombre',    valor: 'Hospital Provincial Dr. Verdi Cevallos Balda' },
    { clave: 'hospital_telefono',  valor: '(05) 259-0140' },
