		break;


	CASE "syr":		// SYRIAC
		$unifont = "estrangeloedessa";
		break;


	//CASE "arc":	// IMPERIAL_ARAMAIC
	//CASE ""ae:	// AVESTAN
	CASE "xcr":		// CARIAN
		$unifont = "aegean";
		break;
	CASE "xlc":		// LYCIAN
