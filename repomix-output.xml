							$html .= ' '.$this->formatEntity($Mark1Glyphs[$i]).' ';
						}
						$html .= '</span></div>';

						if ($firstMark) { 

							$html .= '<div class="glyphs">Bases: <span class="unchanged">';
							for($j=0;$j<count($Mark2Glyphs);$j++) {
								$html .= ' '.$this->formatEntity($Mark2Glyphs[$j]).' ';
							}
