						else { $newinfo[$i]['group'] =  'C'; }
						$newinfo[$i]['uni'] =  $sub[$i];
						$newinfo[$i]['hex'] =  $charasstr;
					}
					array_splice($this->OTLdata, $ptr, 1, $newinfo);
					$ptr += count($sub)-1;
				}
			}
*/

		}


		//-----------------------------------------------------------------------------------
