	}


	function getMetrics($file, $fontkey, $TTCfontID=0, $debug=false, $BMPonly=false, $kerninfo=false, $useOTL=0, $mode) {	// mPDF 5.7.1
		$this->mode = $mode;
		$this->useOTL = $useOTL;	// mPDF 5.7.1
		$this->fontkey = $fontkey;	// mPDF 5.7.1
		$this->filename = $file;
