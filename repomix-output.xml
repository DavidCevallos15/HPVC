  windowMs: 60 * 60 * 1000, // 1 hora
  max: 5,
  message: { success: false, message: 'Demasiados mensajes enviados. Intente nuevamente en 1 hora.' },
});

// ── PUBLIC: Enviar mensaje ──────────────────────────────────────────
