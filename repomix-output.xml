			$decorationfontsize = $this->textparam['u-decoration']['fontsize'] / $shrin_k;
			if (isset($this->fonts[$decorationfontkey]['ut']) && $this->fonts[$decorationfontkey]['ut']) { $ut=$this->fonts[$decorationfontkey]['ut']/1000* $decorationfontsize; }
