else if ($_GET['t']=='bmp') { $filename = 'tiger.wmf'; $mime = 'x-ms-bmp'; }
else { exit; }


$fp = fopen($filename, 'rb');
header("Content-Type: image/".$mime);
header("Content-Length: " . filesize($filename));
fpassthru($fp);
fclose($fp);
exit;
?>
