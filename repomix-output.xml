	  $rangename = '';
	  continue;
	}
	else if (preg_match('/^([12]{0,1}[0-9A-Za-z]{4});<(.*?), Last>/',$line,$m)) { 
	  if ($rangename && $rangename == $m[2]) {
		$endrange = hexdec($m[1]);
		for ($i=$startrange;$i<=$endrange; $i++) {
			$unichars[$i] = $i;
