						//===========
						// Format 2: 
						//===========
						else if ($PosFormat==2) {	
							die("GPOS Lookup Type ".$Type." Format ".$PosFormat." not YET TESTED."); 
						}
						//===========
						// Format 3: 
						//===========
						else if ($PosFormat==3) {	
							die("GPOS Lookup Type ".$Type." Format ".$PosFormat." not YET TESTED."); 
