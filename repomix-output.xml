			}
			else {
				$this->mpdf->SetLineWidth(0.2 /$k );
				$radius = $this->mpdf->FontSize *0.35;
				$cx = $x + ($w/2); 
				$cy = $y + ($h/2);
				if (isset($objattr['disabled']) && $objattr['disabled']) { 
					$this->mpdf->SetFColor($this->mpdf->ConvertColor(127));
