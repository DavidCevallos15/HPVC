					////////////////////////////////////////////////////////////////////////////////
					else if ($Lookup[$luli]['Type'] == 4) {
						$html .= '<div class="lookuptype">LookupType 4: MarkToBase attachment </div>'; 
						$MarkCoverage = $subtable_offset + $this->read_ushort();
