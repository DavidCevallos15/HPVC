					$this->port,
					$this->socket,
					$this->clientFlags);

		if ($ok) {
			if ($argDatabasename)  return $this->SelectDB($argDatabasename);
			return true;
		} else {
			if ($this->debug) {
				ADOConnection::outp("Could't connect : "  . $this->ErrorMsg());
			}
			$this->_connectionID = null;
			return false;
		}
	}

